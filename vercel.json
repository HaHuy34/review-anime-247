{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/visit",
      "destination": "/api/visit.ts"
    },
    {
      "source": "/api/stats",
      "destination": "/api/stats.ts"
    },
    {
      "source": "/api/daily-summary",
      "destination": "/api/daily-summary.ts"
    },
    {
      "source": "/api/product-click",
      "destination": "/api/product-click.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    { "path": "/api/daily-summary", "schedule": "0 0 * * *" },
    { "path": "/api/daily-summary", "schedule": "30 16 * * *" }
  ]
}
